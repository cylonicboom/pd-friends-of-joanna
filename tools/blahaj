def find_root(start):
    d = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(d, 'src', 'include', 'props.h')):
            return d
        p = os.path.dirname(d)
        if p == d:
            return None
        d = p


ROOT = find_root(os.path.dirname(os.path.abspath(__file__))) or find_root('.')

OBJTYPE_END = 0x34
INTRO_END = 0x0c
AICMD_END = 0x0004
AICMD_LABEL = 0x0002
AICMD_YIELD = 0x0003
AICMD_GOTO_NEXT = 0x0000
AICMD_GOTO_FIRST = 0x0001
AICMD_PRINT = 0x00b5

# Record lengths in u32 words for OBJTYPEs that have no authoring macro in
# props.h. Taken from the N64 structs (sizeof / 4); cross-check against
# objSizeN64() in port/src/preprocess/filesetup.c when touching them.
OBJ_LENGTHS = {
    0x05: 23,   # alarm        - struct alarmobj: defaultobj only
    0x0c: 23 + 4,  # hangingmonitors - defaultobj + 4 u32? (verify)
    0x12: 2,    # grenadeprob  - chrnum, probability
    0x1f: 1,
    0x22: 1,
    0x27: 23 + 7,  # truck (verify)
    0x28: 23 + 10, # heli (verify)
    0x2d: 32,   # tank: objSizeN64 says 32
}

# --------------------------------------------------------------------------- #
# Header parsing: #defines, enums, macros
# --------------------------------------------------------------------------- #

_SAFE_EXPR = re.compile(r'^[\s0-9a-fA-FxX()<>|&+\-*~=!/%]+$')


def eval_const(text, env):
    """Evaluate a C integer expression using only literals and known names."""
    t = text.strip()
    t = re.sub(r'/\*.*?\*/', '', t)
    t = re.sub(r'//.*$', '', t).strip()
    if not t:
        return None
    t = re.sub(r'\b(0x[0-9a-fA-F]+|\d+)[uUlL]+\b', r'\1', t)

    def sub(m):
        name = m.group(0)
        if name[0].isdigit():
            return name
        if name in env:
            return str(env[name])
        raise KeyError(name)
    try:
        t2 = re.sub(r'0[xX][0-9a-fA-F]+|\d+|[A-Za-z_]\w*', sub, t)
    except KeyError:
        return None
    m = re.match(r'^\s*\(?\s*(.+?)\s*\?\s*(.+?)\s*:\s*(.+?)\s*\)?\s*$', t2)
    if m and '?' in t2:
        t2 = '((%s) if (%s) else (%s))' % (m.group(2), m.group(1), m.group(3))
    if not _SAFE_EXPR.match(t2.replace(' if ', '').replace(' else ', '')):
        return None
    try:
        return int(eval(t2, {'__builtins__': {}}, {}))
    except Exception:
        return None


def active_lines(path, env):
    """Lines of a header with #if VERSION / PLATFORM_N64 conditionals
    resolved against env; directives themselves are dropped."""
    stack = []      # (active_before, this_branch_taken, any_branch_taken)

    def active():
        return all(x[1] for x in stack)

    def cond(expr):
        expr = expr.strip()
        m = re.match(r'^defined\s*\(?\s*(\w+)\s*\)?$', expr)
        if m:
            return m.group(1) in env
        v = eval_const(expr, env)
        return True if v is None else bool(v)

    for line in open(path, encoding='utf-8', errors='replace'):
        l = line.strip()
        d = re.match(r'#\s*(if|ifdef|ifndef|elif|else|endif)\b\s*(.*)$', l)
        if d:
            kw, rest = d.group(1), re.sub(r'//.*$', '', d.group(2)).strip()
            if kw == 'if':
                c = cond(rest)
                stack.append((active(), c, c))
            elif kw == 'ifdef':
                c = rest.split()[0] in env if rest else False
                stack.append((active(), c, c))
            elif kw == 'ifndef':
                nm = rest.split()[0] if rest else ''
                c = nm not in env or nm.startswith('_IN_') or nm.endswith('_H')
                stack.append((active(), c, c))
            elif kw == 'elif' and stack:
                _, _, anyb = stack[-1]
                c = (not anyb) and cond(rest)
                stack[-1] = (stack[-1][0], c, anyb or c)
            elif kw == 'else' and stack:
                _, _, anyb = stack[-1]
                stack[-1] = (stack[-1][0], not anyb, True)
            elif kw == 'endif' and stack:
                stack.pop()
            continue
        if active():
            yield line


def load_defines(path, env=None):
    """#define NAME <int expr> from a header, honouring the tree's #if
    VERSION / PLATFORM_N64 conditionals (env carries VERSION etc)."""
    env = dict(env or {})
    order = []
    for line in active_lines(path, env):
        l = line.strip()
        m = re.match(r'#\s*define\s+([A-Za-z_]\w*)\s+(.+?)\s*$', l)
        if not m or re.match(r'#\s*define\s+[A-Za-z_]\w*\(', l):
            continue
        v = eval_const(m.group(2), env)
        if v is not None:
            env[m.group(1)] = v
            if m.group(1) not in order:
                order.append(m.group(1))
    return env, order


def load_enums(path, env):
    """enum members from a generated header, in declaration order."""
    text = ''.join(active_lines(path, env))
    text = re.sub(r'//.*', '', text)
    out = []
    for m in re.finditer(r'enum\s+(\w+)\s*\{(.*?)\}', text, re.S):
        val = 0
        for ent in m.group(2).split(','):
            ent = re.sub(r'/\*.*?\*/', '', ent).strip()
            if not ent:
                continue
            if '=' in ent:
                name, expr = [x.strip() for x in ent.split('=', 1)]
                v = eval_const(expr, env)
                if v is None:
                    continue
                val = v
            else:
                name = ent
            env[name] = val
            out.append((name, val))
            val += 1
    return out


def split_top(s, sep=','):
    out, depth, cur, q = [], 0, '', None
    for ch in s:
        if q:
            cur += ch
            if ch == q:
                q = None
            continue
        if ch in '\'"':
            q = ch
            cur += ch
            continue
        if ch == '(':
            depth += 1
        elif ch == ')':
            depth -= 1
        if ch == sep and depth == 0:
            out.append(cur)
            cur = ''
        else:
            cur += ch
    out.append(cur)
    return [x.strip() for x in out if x.strip()]


class Macros:
    """Function-like and object-like macros from one header, expandable."""

    def __init__(self):
        self.defs = {}      # name -> (params or None, [raw tokens])
        self.order = []

    def load(self, path):
        lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
        i = 0
        while i < len(lines):
            line = lines[i]
            m = re.match(r'\s*#\s*define\s+([A-Za-z_]\w*)(\([^)]*\))?\s*(.*?)\s*(\\)?\s*$', line)
            if not m:
                i += 1
                continue
            name = m.group(1)
            params = None
            if m.group(2):
                params = [p.strip() for p in m.group(2)[1:-1].split(',') if p.strip()]
            body_lines = []
            if m.group(3):
                body_lines.append(m.group(3))
            cont = bool(m.group(4))
            while cont and i + 1 < len(lines):
                i += 1
                l = lines[i].rstrip()
                cont = l.endswith('\\')
                if cont:
                    l = l[:-1]
                body_lines.append(l.strip())
            toks = []
            for l in body_lines:
                l = re.sub(r'/\*.*?\*/', '', l)
                toks.extend(split_top(l))
            self.defs[name] = (params, toks)
            self.order.append(name)
            i += 1

    def expand(self, name, args=None, depth=0):
        """Expand macro `name` with symbolic args -> flat list of token strings."""
        params, toks = self.defs[name]
        env = {}
        if params:
            if args is None:
                args = params
            if len(args) != len(params):
                raise ValueError('%s wants %d args, got %d' % (name, len(params), len(args)))
            env = dict(zip(params, args))
        out = []
        for t in toks:
            t = t.strip().rstrip(',').strip()
            if not t:
                continue
            t = self._subst(t, env)
            mc = re.match(r'^([A-Za-z_]\w*)\((.*)\)$', t, re.S)
            if mc and mc.group(1) in self.defs and self.defs[mc.group(1)][0] is not None \
                    and mc.group(1) not in ('_mkword', '_mkshort', 'mkshort', 'mkword'):
                out.extend(self.expand(mc.group(1), split_top(mc.group(2)), depth + 1))
            elif re.match(r'^[A-Za-z_]\w*$', t) and t in self.defs and self.defs[t][0] is None:
                out.extend(self.expand(t, None, depth + 1))
            else:
                out.append(t)
        return out

    @staticmethod
    def _subst(t, env):
        if not env:
            return t
        return re.sub(r'[A-Za-z_]\w*', lambda m: env.get(m.group(0), m.group(0)), t)


# --------------------------------------------------------------------------- #
# Expression inversion
# --------------------------------------------------------------------------- #

class Fail(Exception):
    pass


def parse_expr(s):
    """Tiny C expression parser -> ('num', v) | ('id', name) | ('call', name, [args]) | ('neg', e)"""
    s = s.strip()
    if s.startswith('(') and s.endswith(')') and _balanced(s[1:-1]):
        return parse_expr(s[1:-1])
    if s.startswith('-'):
        return ('neg', parse_expr(s[1:]))
    m = re.match(r'^([A-Za-z_]\w*)\((.*)\)$', s, re.S)
    if m and _balanced(m.group(2)):
        return ('call', m.group(1), [parse_expr(a) for a in split_top(m.group(2))])
    for op in ('/', '*'):
        parts = split_top(s, op)
        if len(parts) == 2 and _balanced(parts[0]) and _balanced(parts[1]):
            return ('bin', op, parse_expr(parts[0]), parse_expr(parts[1]))
    m = re.match(r'^(0x[0-9a-fA-F]+|\d+)$', s)
    if m:
        return ('num', int(s, 0))
    m = re.match(r"^'(\\.|.)'$", s)
    if m:
        return ('num', ord(eval(s)))
    if re.match(r'^[A-Za-z_]\w*$', s):
        return ('id', s)
    raise ValueError('cannot parse expression: %r' % s)


def _balanced(s):
    d = 0
    for ch in s:
        if ch == '(':
            d += 1
        elif ch == ')':
            d -= 1
            if d < 0:
                return False
    return d == 0


def expr_text(e):
    k = e[0]
    if k == 'num':
        return '%#x' % e[1]
    if k == 'id':
        return e[1]
    if k == 'neg':
        return '-' + expr_text(e[1])
    if k == 'bin':
        return '%s %s %s' % (expr_text(e[2]), e[1], expr_text(e[3]))
    return '%s(%s)' % (e[1], ', '.join(expr_text(a) for a in e[2]))


def invert(e, value, bits, params, binds, consts):
    """Solve expression tree e == value (a bits-wide field). Binds params."""
    mask = (1 << bits) - 1
    value &= mask
    k = e[0]
    if k == 'num':
        if (e[1] & mask) != value:
            raise Fail()
    elif k == 'neg':
        inner = e[1]
        if inner[0] == 'num':
            if ((-inner[1]) & mask) != value:
                raise Fail()
        else:
            invert(inner, (-value) & mask, bits, params, binds, consts)
    elif k == 'id':
        name = e[1]
        if name in params:
            if name in binds:
                if (binds[name][0] & mask) != value:
                    raise Fail()
            else:
                binds[name] = (value, bits)
        elif name in consts:
            if (consts[name] & mask) != value:
                raise Fail()
        else:
            raise Fail()
    elif k == 'bin':
        op, lhs, rhs = e[1], e[2], e[3]
        if rhs[0] != 'num' or rhs[1] == 0:
            raise Fail()
        if op == '/':
            # x / n == value: x = value * n (the decomp writes the unscaled number)
            invert(lhs, value * rhs[1], 32, params, binds, consts)
        else:
            if value % rhs[1]:
                raise Fail()
            invert(lhs, value // rhs[1], 32, params, binds, consts)
    elif k == 'call':
        fn, args = e[1], e[2]
        if fn == '_mkword' and len(args) == 2 and bits == 32:
            invert(args[0], value >> 16, 16, params, binds, consts)
            invert(args[1], value & 0xffff, 16, params, binds, consts)
        elif fn == '_mkshort' and len(args) == 2 and bits == 16:
            invert(args[0], value >> 8, 8, params, binds, consts)
            invert(args[1], value & 0xff, 8, params, binds, consts)
        else:
            raise Fail()
    else:
        raise Fail()


# --------------------------------------------------------------------------- #
# Names: constants, generated enums, the decomp's own source for the stage
# --------------------------------------------------------------------------- #

class Names:
    def __init__(self, root, romid, stagekey, setupname, auto):
        self.root = root
        self.romid = romid
        self.key = stagekey
        verenv, _ = load_defines(os.path.join(root, 'src/include/versions.h'))
        verenv['VERSION'] = {'ntsc-beta': 0, 'ntsc-1.0': 1, 'ntsc-final': 2, 'pal-beta': 3,
                             'pal-final': 4, 'jpn-final': 5}.get(romid, 2)
        verenv['PAL'] = 1 if romid.startswith('pal') else 0
        self.consts, self.const_order = load_defines(os.path.join(root, 'src/include/constants.h'), verenv)
        self.fileids, _ = load_defines(os.path.join(root, 'src/include/files.h'), verenv)
        self.by_prefix = {}
        for name in self.const_order:
            pre = name.split('_')[0] + '_'
            self.by_prefix.setdefault(pre, []).append(name)
        gen = os.path.join(root, 'src/generated', romid)
        sk = stagekey or '\0'
        self.pads = self._enum(os.path.join(gen, 'pads', sk + '.h'))
        self.rooms = self._enum(os.path.join(gen, 'tiles', sk + '.h'))
        self.lang = self._enum(os.path.join(gen, 'lang', sk + '.h'))
        self.anims = self._enum(os.path.join(gen, 'animations.h'))
        self.sounds = {}
        sfx = os.path.join(root, 'src/include/sfx.h')
        if os.path.isfile(sfx):
            env = dict(self.fileids, **verenv)
            for nm, v in load_enums(sfx, env):
                if nm.startswith(('SFX_', 'MP3_')):
                    self.sounds.setdefault(v, nm)
            env, order = load_defines(sfx, env)
            for nm in order:
                if nm.startswith(('SFX_', 'MP3_')):
                    self.sounds.setdefault(env[nm], nm)
        self.music = self._enum(os.path.join(gen, 'sequences.h'))
        self.langtext = {}
        lj = os.path.join(root, 'src/assets', romid, 'lang', sk + '.json')
        if os.path.isfile(lj):
            try:
                for r in json.load(open(lj)):
                    self.langtext[r['id']] = r.get('text', r.get('value', ''))
            except Exception:
                pass
        # harvested from the decomp's own source for this stage
        self.local = {}        # family -> {value: name}
        self.local_defs = []   # (family, name, value) in file order
        self.funcnames = {}    # ailist id -> func name
        self.unreg_lists = []  # decomp's names for unregistered lists, in order
        self.unreg_paths = []
        self.textnames = []
        src = os.path.join(root, 'src/setups', setupname + '.c')
        if auto and os.path.isfile(src):
            self._harvest(src)

    def _enum(self, path):
        if not os.path.isfile(path):
            return {}
        env = {}
        return {v: n for n, v in load_enums(path, env)}

    def _harvest(self, src):
        text = open(src, encoding='utf-8', errors='replace').read()
        for m in re.finditer(r'^#define\s+([A-Z][A-Z0-9_]*)\s+(-?0x[0-9a-fA-F]+|-?\d+)\s*$', text, re.M):
            name, val = m.group(1), int(m.group(2), 0)
            fam = name.split('_')[0] + '_'
            self.local.setdefault(fam, {}).setdefault(val & 0xffffffff, name)
            self.local_defs.append((fam, name, val))
        # the decomp's ailists[] in table order: ids repeat (dish has four
        # 0x1021 lists), so names are matched by (id, nth occurrence)
        self.funcs_in_order = []
        for m in re.finditer(r'\{\s*(func[0-9a-fA-F]{4}_\w*)\s*,\s*(0x[0-9a-fA-F]+|[A-Z_0-9]+)\s*\}', text):
            fn, ident = m.group(1), m.group(2)
            if ident.startswith('0x'):
                v = int(ident, 16)
            elif ident in self.consts:
                v = self.consts[ident]
            else:
                v = None
                for vv, nn in self.local.get('AILIST_', {}).items():
                    if nn == ident:
                        v = vv
            if v is not None:
                self.funcs_in_order.append((v, fn))
        seen = {}
        for v, fn in self.funcs_in_order:
            k = seen.get(v, 0)
            self.funcnames[(v, k)] = fn
            seen[v] = k + 1
        self.unreg_lists = re.findall(r'^u8 (\w*unregistered\w*)\[\]', text, re.M)
        self.unreg_paths = re.findall(r'^s32 (\w*unregistered\w*)\[\]', text, re.M)
        self.textnames = re.findall(r'^char \*(\w+) = "', text, re.M)

    # -- lookups ---------------------------------------------------------
    def const(self, prefix, value, bits=32):
        mask = (1 << bits) - 1
        value &= mask
        for name in self.by_prefix.get(prefix, []):
            if (self.consts[name] & mask) == value:
                return name
        return None

    def flags(self, prefix, value, bits=32, prefer=None):
        """Decompose value into OR of single-bit constants with this prefix.
        Aliases for one bit (OBJFLAG2_DOOR_* / OBJFLAG2_AUTOGUN_*) pick the
        one naming `prefer` (the macro) when there is one."""
        if value == 0:
            return '0'
        exact = self.const(prefix, value, bits)
        if exact and (value & (value - 1)) != 0:
            return exact
        names = []
        rem = value & ((1 << bits) - 1)
        key = (prefer or '').upper().replace('_', '')
        cands = self.by_prefix.get(prefix, [])
        for name in cands:
            v = self.consts[name]
            if v and (v & (v - 1)) == 0 and (rem & v):
                alts = [a for a in cands if self.consts[a] == v]
                named = [a for a in alts if not re.search(r'_[0-9A-F]{4,}$|_[0-9]{2,}$', a)] or alts
                generic = [a for a in named if not self._typed(a, prefix)]
                mine = [a for a in named if key and key in a.upper().replace('_', '')]
                pick = (generic or mine or named)[0]
                if mine and not generic:
                    pick = mine[0]
                names.append(pick)
                rem &= ~v
        if not names:
            return None
        if rem:
            names.append('0x%08x' % rem)
        return ' | '.join(names)

    TYPEWORDS = ('DOOR', 'AUTOGUN', 'GLASS', 'LIFT', 'WEAPON', 'CHR', 'CAMERA', 'MONITOR',
                 'HOVER', 'FAN', 'SAFE', 'TAG', 'KEY', 'DEBRIS', 'CCTV', 'TANK', 'HELI',
                 'TRUCK', 'ESCASTEP', 'CHOPPER', 'AMMOCRATE', 'ALARM', 'GASBOTTLE', 'MINE',
                 'SHIELD', 'HAT', 'PROP')

    def _typed(self, name, prefix):
        rest = name[len(prefix):]
        return any(rest.startswith(t + '_') or rest.startswith(t) and rest[len(t):len(t) + 1].isdigit() is False and '_' + t + '_' in '_' + rest for t in self.TYPEWORDS)

    def local_name(self, fam, value, bits=32):
        return self.local.get(fam, {}).get(value & ((1 << bits) - 1))

    def pad(self, value, bits=16):
        v = value & ((1 << bits) - 1)
        n = self.local_name('PAD_', v, bits)
        if n:
            return n
        if v in self.pads:
            return self.pads[v]
        return None

    def room(self, value):
        return self.rooms.get(value)

    def sound(self, value):
        return self.sounds.get(value)

    def text(self, value):
        n = self.lang.get(value)
        if not n:
            return None, None
        return n, self.langtext.get(n)


# --------------------------------------------------------------------------- #
# Value formatting rules
# --------------------------------------------------------------------------- #

def hexw(v, bits):
    return '0x%0*x' % (bits // 4, v & ((1 << bits) - 1))


def signed(v, bits):
    if v & (1 << (bits - 1)):
        return v - (1 << bits)
    return v


class Formatter:
    """Turns a bound macro parameter into the token the decomp would write.

    Rules are keyed by parameter name (as spelled in the header macro), with
    a few per-macro overrides. Anything without a rule is hex at its width.
    A rule may return (text, comment); the comment lands after the call.
    """

    DEC = {'maxdamage', 'hear_scale', 'view_dist', 'convtalk', 'tude', 'naturalanim',
           'yvisang', 'teamscandist', 'value', 'stopnum', 'distance',
           'speed', 'seconds', 'amount', 'health', 'accuracy', 'walkspeed', 'angle',
           'volume', 'time', 'timemerge', 'animspeed', 'to', 'from', 'duration60',
           'reaction', 'recovery', 'shield', 'frames', 'percentage', 'ammo',
           'quantity', 'rand', 'chance', 'ticks', 'score', 'count', 'slot',
           'image', 'image1', 'image2', 'image3', 'image4', 'diffbit_unused'}
    SIGNED = {'startframe', 'endframe', 'chair', 'chrpreset', 'padpreset'}
    HEX2 = {'id', 'chrnum', 'object', 'door', 'lift', 'operation', 'entity_id',
            'whichprop', 'modelpart', 'criteria', 'action', 'checktype', 'operator',
            'player', 'chr'}

    def __init__(self, names):
        self.n = names
        self.objtypes = {}

    def fmt(self, macro, param, value, bits, ctx, binds=None):
        n = self.n
        p = param
        r = None
        if p == 'label':
            return '/*goto*/ ' + hexw(value, 8)
        if macro in ('case', 'case_respawn') and p == 'id':
            return str(value)
        if macro == 'object_do_animation' and p == 'startframe':
            return hexw(value, bits)
        if p == 'objective':
            return str(value)
        if p == 'special':
            return (n.const('BANK_', value, bits) if value < 2 else None) or hexw(value, bits)
        if p == 'bool':
            return {0: 'FALSE', 1: 'TRUE'}.get(value, hexw(value, bits))
        if p in ('pad', 'targetpad', 'pad1', 'pad2', 'pad3', 'pad4', 'roomorpad') \
                or (p == 'chr' and macro in ('weapon', 'hat')):
            if value == 0xffff:
                return '-1'
            if p == 'roomorpad':
                return hexw(value, bits)
            r = n.pad(value, bits)
        elif p == 'model':
            r = n.const('MODEL_', value, bits) if (value or macro != 'weapon') else hexw(value, bits)
        elif ctx == 'props' and macro == 'chr' and p == 'flags':
            r = n.flags('CHRFLAG0_', value, bits)
        elif ctx == 'props' and macro == 'chr' and p == 'flags2':
            r = n.flags('CHRFLAG1_', value, bits)
        elif ctx == 'props' and p == 'flags':
            r = n.flags('OBJFLAG_', value, bits, prefer=macro)
        elif ctx == 'props' and p == 'flags2':
            r = n.flags('OBJFLAG2_', value, bits, prefer=macro)
        elif ctx == 'props' and p == 'flags3':
            r = n.flags('OBJFLAG3_', value, bits, prefer=macro)
        elif p == 'diffbit':
            r = n.flags('DIFFBIT_', value, bits)
            if r and '|' in r:
                r = '(' + r + ')'
        elif p == 'doorstate':
            r = n.flags('DOORSTATE_', value, bits)
            if r and '|' in r:
                r = '(' + r + ')'
        elif p == 'portal':
            return hexw(value, bits)
        elif p == 'flag' and macro == 'set_portal_flag':
            r = n.flags('PORTALFLAG_', value, bits)
        elif p == 'image' and macro == 'set_object_image':
            r = n.const('TVCMDLIST_', value, bits)
        elif p in self.SIGNED:
            return str(signed(value, bits)) if value & (1 << (bits - 1)) else (str(value) if p in ('startframe', 'endframe') else hexw(value, bits))
        elif p in ('objectflag', 'objectflag2', 'objectflag3'):
            obj = binds.get('object', (None,))[0] if binds else None
            otype = (self.objtypes or {}).get(obj) if obj is not None else None
            r = n.flags({'objectflag': 'OBJFLAG_', 'objectflag2': 'OBJFLAG2_', 'objectflag3': 'OBJFLAG3_'}[p],
                        value, bits, prefer=otype)
        elif p == 'doorflags':
            r = n.flags('DOORFLAG_', value, bits)
        elif p == 'doortype':
            r = n.const('DOORTYPE_', value, bits)
        elif p in self.DEC:
            return str(value)
        elif p == 'body':
            r = n.const('BODY_', value, bits)
        elif p == 'head':
            r = n.const('HEAD_', value, bits)
        elif p == 'spawnflags':
            r = n.flags('SPAWNFLAG_', value, bits)
        elif p == 'team':
            r = n.const('TEAM_', value, bits)
        elif p == 'squadron':
            r = n.const('SQUADRON_', value, bits)
        elif p == 'function':
            r = n.local_name('AILIST_', value, bits)
        elif p in ('ailist', 'ailistid') or p.endswith('list'):
            r = n.local_name('AILIST_', value, bits) or n.const('GAILIST_', value, bits)
        elif p in ('weapon', 'gun', 'weaponnum', 'weapon_fallback'):
            r = n.const('WEAPON_', value, bits)
        elif p == 'ammotype':
            r = n.const('AMMOTYPE_', value, bits)
        elif p == 'outfit':
            r = n.const('OUTFIT_', value, bits)
        elif p == 'room':
            return hexw(value, bits)
        elif p == 'text' or re.match(r'^text\d*$', p):
            name, s = n.text(value)
            if name:
                if s:
                    return name, '"%s"' % s.replace('\n', ' ').replace('"', '\\"')
                return name
            if value == 0xffff:
                return hexw(value, bits), 'unknown text'
            if value < 0x10000:
                return hexw(value, 16)
        elif p == 'stageflag':
            r = n.local_name('STAGEFLAG_', value, bits)
            if not r:
                loc = n.local.get('STAGEFLAG_', {})
                parts, rem = [], value
                for v, nm in loc.items():
                    if v and (v & (v - 1)) == 0 and rem & v:
                        parts.append(nm)
                        rem &= ~v
                if parts:
                    r = ' | '.join(parts + ([hexw(rem, bits)] if rem else []))
        elif p == 'object' or p.endswith('object') or p == 'obj':
            r = n.local_name('OBJ_', value, bits)
        elif p == 'chrnum' and macro == 'chr':
            r = n.local_name('CHR_', value, bits)
        elif p == 'chr' or p.endswith('chr') or p == 'player':
            if bits == 8 and value == 0xff:
                return '-1'
            if value >= 0xf0 and bits == 8:
                r = n.const('CHR_', value, bits)
            if not r:
                r = n.local_name('CHR_', value, bits)
        elif p == 'color':
            r = n.const('COLOR_', value, bits)
        elif p in ('difficulty', 'diff'):
            r = n.const('DIFF_', value, bits)
        elif p == 'animation':
            r = n.anims.get(value)
        elif p in ('music', 'tracknum'):
            r = n.music.get(value)
        elif p == 'hovtype':
            r = n.const('HOVTYPE_', value, bits)
        elif p == 'chranimflags':
            r = n.flags('CHRANIMFLAG_', value, bits)
        elif p == 'chrflag3':
            r = n.flags('CHRCFLAG_', value, bits)
        elif p == 'chrflag2':
            r = n.flags('CHRHFLAG_', value, bits)
        elif p in ('flag', 'props') and binds and 'bank' in binds:
            r = n.flags('CHRFLAG%d_' % binds['bank'][0], value, bits)
        elif p == 'bank':
            r = n.const('BANK_', value, bits)
        elif p == 'attackflags':
            r = n.flags('ATTACKFLAG_', value, bits)
        elif p in ('sound', 'id') and macro.startswith('play_sound') or p == 'sound':
            r = n.sound(value)
        elif p == 'channel':
            if value == 0xff:
                return '-1'
            r = n.const('CHANNEL_', value, bits)
        elif p == 'stage':
            r = n.const('STAGE_', value, bits)
        elif p == 'quip' and binds and binds.get('bank', (1,))[0] == 0:
            r = n.const('QUIP_', value, bits)
        elif p.endswith('offset') and macro not in ('rename_object',):
            return str(signed(value, bits))
        # per-macro overrides
        if macro == 'set_lights_state' and p == 'operation':
            r = n.const('LIGHTOP_', value, bits)
        elif macro == 'configure_environment' and p == 'operation':
            r = n.const('AIENVCMD_', value, bits)
        elif p == 'entity_id' and value == 0:
            return '0'
        if r:
            return r
        if p in self.HEX2 and bits > 8 and value < 0x100:
            return hexw(value, 8)
        return hexw(value, bits)


