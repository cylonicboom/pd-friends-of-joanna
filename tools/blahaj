def fmt_arg(f, macro, p, v, bits, ctx, binds, comments):
    r = f.fmt(macro, p, v, bits, ctx, binds)
    if isinstance(r, tuple):
        comments.append(r[1])
        return r[0]
    return r


class Tables:
    def __init__(self, root, consts):
        self.consts = consts
        self.props = Macros()
        self.props.load(os.path.join(root, 'src/include/props.h'))
        self.intro = Macros()
        self.intro.load(os.path.join(root, 'src/include/intro.h'))
        self.cmds = Macros()
        self.cmds.load(os.path.join(root, 'src/include/commands.h'))
        self.cmdlens = self._cmdlens(os.path.join(root, 'src/game/chrai.c'))
        self.prop_by_type = self._index_words(self.props, exclude={'_generic_object', '_mkshort', '_mkword'})
        self.intro_by_type = self._index_words(self.intro)
        self.cmd_by_op = self._index_cmds()

    @staticmethod
    def _cmdlens(path):
        text = open(path, encoding='utf-8', errors='replace').read()
        out = {}
        m = re.search(r'g_CommandLengths\[\]\s*=\s*\{(.*?)\n\};', text, re.S)
        if m:
            for mm in re.finditer(r'/\*\s*(0x[0-9a-fA-F]+)\s*\*/\s*(\d+)', m.group(1)):
                out[int(mm.group(1), 16)] = int(mm.group(2))
        return out

    def _index_words(self, macros, exclude=()):
        """type byte -> [(name, params, [expr trees])] for word-array macros."""
        idx = {}
        for name in macros.order:
            if name in exclude or name.startswith('_'):
                continue
            params, _ = macros.defs[name]
            try:
                toks = macros.expand(name)
                trees = [parse_expr(t) for t in toks]
            except Exception:
                continue
            if not trees:
                continue
            t0 = trees[0]
            typ = None
            if t0[0] == 'num':
                typ = t0[1] & 0xff
            elif t0[0] == 'call' and t0[1] == '_mkword' and t0[2][1][0] == 'num':
                typ = t0[2][1][1] & 0xff
            if typ is None:
                continue
            idx.setdefault(typ, []).append((name, params or [], trees))
        return idx

    def _index_cmds(self):
        idx = {}
        for name in self.cmds.order:
            params, raw = self.cmds.defs[name]
            if not raw:
                continue
            m = re.match(r'mkshort\(\s*(0x[0-9a-fA-F]+)\s*\)', raw[0].strip())
            toks = raw
            if not m:
                # a macro built from one other command (remove_hudmsgs) is a
                # more specific spelling of that command; two or more commands
                # (beginloop) is structure, handled by the printer
                try:
                    toks = self.cmds.expand(name)
                except Exception:
                    continue
                if not toks or not re.match(r'mkshort\(\s*0x[0-9a-fA-F]+\s*\)$', toks[0].strip()):
                    continue
                m = re.match(r'mkshort\(\s*(0x[0-9a-fA-F]+)\s*\)', toks[0].strip())
                nbytes = sum(2 if t.strip().startswith('mkshort(') else 4 if t.strip().startswith('mkword(') else 1
                             for t in toks if t.strip())
                if self.cmdlens.get(int(m.group(1), 16)) != nbytes:
                    continue
            op = int(m.group(1), 16)
            layout = []
            ok = True
            for t in toks[1:]:
                t = t.strip().rstrip(',').strip()
                if not t:
                    continue
                ms = re.match(r'mkshort\(\s*(.+)\s*\)$', t)
                mw = re.match(r'mkword\(\s*(.+)\s*\)$', t)
                try:
                    if ms:
                        layout.append((parse_expr(ms.group(1)), 16))
                    elif mw:
                        layout.append((parse_expr(mw.group(1)), 32))
                    else:
                        layout.append((parse_expr(t), 8))
                except ValueError:
                    ok = False
                    break
            if not ok:
                continue
            idx.setdefault(op, []).append((name, params or [], layout))
        # a macro that bakes more of its operands (remove_hudmsgs over
        # show_hudmsg_middle) is the more specific reading: try it first
        for op in idx:
            idx[op].sort(key=lambda c: -sum(1 for t, _ in c[2] if t[0] == 'num'))
        return idx


