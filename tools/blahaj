def rom_file(rom_path, filename):
    sys.path.insert(0, os.path.join(ROOT, 'tools', 'lib', 'packages', 'python'))
    sys.path.insert(0, os.path.join(ROOT, '..', 'docker-caroll', 'lib', 'packages', 'python'))
    from leylinelib.pd_rom_driver import PDROMDriver
    rom = open(rom_path, 'rb').read()
    drv = PDROMDriver(rom_path=rom_path)
    for f in drv.get_files():
        if f['name'] == filename:
            return rom[f['offset']:f['end_offset']], getattr(drv, 'romid', None) or getattr(drv, 'variant', None)
    sys.exit('blahaj: %s is not a file in %s' % (filename, rom_path))


def xdelta_apply(xd, src, patch, out):
    subprocess.check_call([xd, '-d', '-f', '-s', src, patch, out])


def setup_name_from(filename):
    base = os.path.basename(filename)
    base = re.sub(r'\.(bin|z|Z)$', '', base)
    m = re.match(r'^U(mp_)?setup(\w+?)Z?$', base)
    if m:
        return (m.group(1) or '') + 'setup' + m.group(2)
    m = re.match(r'^(mp_)?setup(\w+)$', base)
    if m:
        return base
    return base


def stage_key(setupname):
    return re.sub(r'^(mp_)?setup', '', setupname)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('input', help='setup file on disk, or its ROM name with --rom')
    ap.add_argument('--rom', help='ROM to pull the file from')
    ap.add_argument('--xdelta', help='whole-rom xdelta to apply to --rom first')
    ap.add_argument('--file-patch', help='per-file xdelta applied after inflate (mod patches/)')
    ap.add_argument('--xdelta3', default=os.environ.get('XDELTA3', 'xdelta3'))
    ap.add_argument('--romid', default=os.environ.get('ROMID', 'ntsc-final'))
    ap.add_argument('--name', help='setup name for the output (setupdish, mp_setupmp1)')
    ap.add_argument('--stage', help='stage key for pad/room/text names (dish, mp4); default: from a '
                    'vanilla-looking file name, none for a mod file (its pads are not the tree\'s)')
    ap.add_argument('--names', default='auto', help='auto (harvest src/setups/<name>.c) or none')
    ap.add_argument('--tree', default=ROOT, help='pd-fojo tree root')
    ap.add_argument('-o', '--output', help='write C here (default stdout)')
    ap.add_argument('--raw-out', help='also write the inflated input bytes here (for cmp)')
    ap.add_argument('--lossy', action='store_true',
                    help='write a prop as its macro even when a word the macro bakes (runtime '
                         'state a level editor left behind) differs; each such word is noted in '
                         'a comment and the rebuild is not byte-identical there')
    ap.add_argument('--check', action='store_true',
                    help='after writing, rebuild the C with tools/mksetups (clang+lld) and compare '
                         'the bytes with the input; exit 1 if they differ')
    ap.add_argument('-q', '--quiet', action='store_true')
    args = ap.parse_args()

    root = args.tree
    if not root or not os.path.isfile(os.path.join(root, 'src/include/props.h')):
        sys.exit('blahaj: cannot find the pd-fojo tree (pass --tree)')

    warnings = []

    def warn(msg):
        warnings.append(msg)
        if not args.quiet:
            print('blahaj: ' + msg, file=sys.stderr)

    if args.rom:
        rom = args.rom
        tmp = None
        if args.xdelta:
            xd = shutil.which(args.xdelta3)
            if not xd:
                sys.exit('blahaj: no xdelta3 on PATH (brew install xdelta / apt install xdelta3)')
            tmp = tempfile.NamedTemporaryFile(suffix='.z64', delete=False)
            tmp.close()
            xdelta_apply(xd, rom, args.xdelta, tmp.name)
            rom = tmp.name
        blob, _ = rom_file(rom, args.input)
        if tmp:
            os.unlink(tmp.name)
        data = inflate1173(blob)
        setupname = args.name or setup_name_from(args.input)
    else:
        data = inflate1173(open(args.input, 'rb').read())
        setupname = args.name or setup_name_from(args.input)

    if args.file_patch:
        xd = shutil.which(args.xdelta3)
        if not xd:
            sys.exit('blahaj: no xdelta3 on PATH')
        with tempfile.TemporaryDirectory() as td:
            src = os.path.join(td, 'src.bin')
            out = os.path.join(td, 'out.bin')
            open(src, 'wb').write(data)
            xdelta_apply(xd, src, args.file_patch, out)
            data = open(out, 'rb').read()

    if args.raw_out:
        open(args.raw_out, 'wb').write(data)

    tables = Tables(root, {})
    inname = os.path.basename(args.input)
    vanilla_like = re.match(r'^U(mp_)?setup[a-z0-9]+Z(\.bin)?$', inname) is not None
    if args.stage:
        key = args.stage
    elif vanilla_like:
        key = stage_key(setupname)
    else:
        key = None
        warn('%s does not look like a vanilla file name: pads, rooms and text stay numeric (pass --stage KEY to use a stage\'s names)' % inname)
    names = Names(root, args.romid, key, setupname, args.names == 'auto' and key is not None)
    tables.consts = names.consts
    fmt = Formatter(names)
    s = Setup(data, tables, names, fmt, setupname, warn)
    s.lossy = args.lossy
    s.parse()
    fmt.objtypes = s.objtypes
    text = s.emit()
    if args.output:
        os.makedirs(os.path.dirname(os.path.abspath(args.output)), exist_ok=True)
        open(args.output, 'w').write(text)
    else:
        sys.stdout.write(text)
    if not args.quiet:
        print('blahaj: %s: %d bytes, %d regions, %d raw props, %d raw list tails, %d lossy words, %d warnings' % (
            setupname, len(data), len(s.regions), s.raw_props, s.raw_lists, s.lossy_words, len(warnings)), file=sys.stderr)
    if args.check:
        sys.exit(0 if roundtrip(root, args.romid, setupname, text, data) else 1)


def roundtrip(root, romid, setupname, text, data):
    """Build the emitted C with tools/mksetups and compare with the input."""
    srcdir = os.path.join(root, 'build', romid, 'blahaj')
    os.makedirs(srcdir, exist_ok=True)
    open(os.path.join(srcdir, setupname + '.c'), 'w').write(text)
    cmd = [sys.executable, os.path.join(root, 'tools', 'mksetups'), '--no-headers',
           '--romid', romid, '--src-dir', srcdir, setupname]
    r = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if r.returncode:
        print('blahaj: check: mksetups failed:\n' + r.stdout.decode(errors='replace'), file=sys.stderr)
        return False
    built = open(os.path.join(root, 'build', romid, 'files', 'setup', setupname + '.bin'), 'rb').read()
    if built == data:
        print('blahaj: check: %s rebuilds byte-identical (%d bytes)' % (setupname, len(data)), file=sys.stderr)
        return True
    n = next((i for i in range(min(len(built), len(data))) if built[i] != data[i]), min(len(built), len(data)))
    print('blahaj: check: %s DIFFERS at +%#x (built %d bytes, input %d bytes)' % (setupname, n, len(built), len(data)), file=sys.stderr)
    return False


if __name__ == '__main__':
    main()
