def be32(b, off):
    return struct.unpack_from('>I', b, off)[0]


def inflate1173(b):
    if len(b) >= 5 and b[:2] == b'\x11\x73':
        return zlib.decompress(b[5:], -15)
    return bytes(b)


class Region:
    def __init__(self, start, end, kind, name, payload=None):
        self.start, self.end, self.kind, self.name, self.payload = start, end, kind, name, payload

    def __repr__(self):
        return '<%s %s %#x-%#x>' % (self.kind, self.name, self.start, self.end)


class Setup:
    def __init__(self, data, tables, names, fmt, setupname, warn):
        self.d = data
        self.t = tables
        self.n = names
        self.f = fmt
        self.name = setupname
        self.warn = warn
        self.regions = []
        self.raw_props = 0
        self.raw_lists = 0
        self.lossy = False
        self.lossy_words = 0
        self.hdr = [be32(data, i * 4) for i in range(8)]

    # -- layout --------------------------------------------------------
    def parse(self):
        d = self.d
        h = self.hdr
        for i, nm in ((0, 'waypoints'), (1, 'waygroups'), (2, 'cover'), (7, 'padfiledata')):
            if h[i]:
                self.warn('header slot %s is %#x; no setup in the decomp uses it, emitted as a raw offset' % (nm, h[i]))
        self.regions.append(Region(0, 0x20, 'header', 'setup'))
        starts = set()
        # tables first: they give us every pointer
        if h[6]:
            lists = []
            off = h[6]
            while True:
                ptr, lid = be32(d, off), be32(d, off + 4)
                off += 8
                if ptr == 0:
                    break
                lists.append((ptr, lid))
            self.regions.append(Region(h[6], off, 'ailists', 'ailists', lists))
            for ptr, lid in lists:
                starts.add(ptr)
        if h[5]:
            paths = []
            off = h[5]
            while True:
                ptr, pid, pflags, plen = be32(d, off), d[off + 4], d[off + 5], struct.unpack_from('>H', d, off + 6)[0]
                off += 8
                if ptr == 0:
                    paths.append((ptr, pid, pflags, plen))
                    break
                paths.append((ptr, pid, pflags, plen))
            self.regions.append(Region(h[5], off, 'paths', 'paths', paths))
            for ptr, _, _, _ in paths:
                if ptr:
                    starts.add(ptr)
        for i in range(3, 8):
            if h[i]:
                starts.add(h[i])
        starts.add(len(d))
        # props
        self.objtypes = {}    # prop index -> macro name, for flag aliases in aicmds
        if h[4]:
            end = self._walk_props(h[4])
            self.regions.append(Region(h[4], end, 'props', 'props'))
            # ailists name objects by tag number; a tag record binds its
            # tagnum to the record cmdoffset entries after it (setup.c:1999)
            off, idx = h[4], 0
            types, tags = [], []
            while off < end:
                typ = d[off + 3]
                if typ == OBJTYPE_END:
                    break
                cands = self.t.prop_by_type.get(typ)
                types.append(cands[0][0] if cands else None)
                if typ == 0x16:
                    tagnum = struct.unpack_from('>H', d, off + 4)[0]
                    cmdoff = struct.unpack_from('>h', d, off + 6)[0]
                    tags.append((tagnum, idx + cmdoff))
                idx += 1
                off += (self.prop_len(off) or 1) * 4
            for tagnum, i in tags:
                if 0 <= i < len(types):
                    self.objtypes[tagnum] = types[i]
        if h[3]:
            end = self._walk_intro(h[3])
            self.regions.append(Region(h[3], end, 'intro', 'intro'))
        # path pad arrays
        if h[5]:
            pathregion = [r for r in self.regions if r.kind == 'paths'][0]
            seenp = set()
            for i, (ptr, pid, pflags, plen) in enumerate(pathregion.payload):
                if not ptr or ptr in seenp:
                    continue
                seenp.add(ptr)
                off = ptr
                while struct.unpack_from('>i', d, off)[0] >= 0:
                    off += 4
                off += 4
                self.regions.append(Region(ptr, off, 'path', 'path'))
        # ailist bodies
        if h[6]:
            lr = [r for r in self.regions if r.kind == 'ailists'][0]
            covered = sorted(starts | {r.start for r in self.regions})
            seen = set()
            nth = {}
            for ptr, lid in lr.payload:
                k = nth.get(lid, 0)
                nth[lid] = k + 1
                if ptr in seen:
                    continue
                seen.add(ptr)
                nxt = min([s for s in covered if s > ptr] + [len(d)])
                end = self._walk_list(ptr, nxt)
                nm = self.n.funcnames.get((lid, k)) or ('func%04x' % lid if k == 0 else 'func%04x_%d' % (lid, k + 1))
                self.regions.append(Region(ptr, end, 'ailist', nm, lid))
        # orphans and padding. A run of zeros is alignment padding only when
        # the compiler would put it there itself: fewer than 4 bytes before a
        # 4-aligned region, or the linker's ALIGN(0x10) at the end of the
        # file. Any other zeros are data the file carries (GE-editor output
        # pads its tables) and are emitted so they come back.
        self.regions.sort(key=lambda r: r.start)
        cursor = 0
        extra = []
        for r in list(self.regions):
            if r.start > cursor:
                gap = d[cursor:r.start]
                if any(gap) or len(gap) >= 4 or r.start % 4:
                    extra.extend(self._carve_orphans(cursor, r.start, keep_zeros=not any(gap)))
            cursor = max(cursor, r.end)
        if cursor < len(d):
            tail = d[cursor:]
            linker_pad = (-cursor) % 16
            if any(tail) or len(tail) != linker_pad:
                extra.extend(self._carve_orphans(cursor, len(d), keep_zeros=not any(tail)))
        self.regions.extend(extra)
        self.regions.sort(key=lambda r: r.start)
        # a text table's strings live in .rodata, after .data: drop whatever
        # the carver made of them and remember where .data ends
        self.rodata_start = None
        for r in self.regions:
            if r.kind == 'texttable':
                lo = min(r.payload[0])
                self.rodata_start = lo
                keep = []
                for x in self.regions:
                    if x.start >= lo or (x.end > lo and not any(d[x.start:lo])):
                        continue
                    if x.end > lo:
                        self.warn('region %r runs into the credits text at %#x' % (x, lo))
                    keep.append(x)
                self.regions = keep
                break
        # names, in file order, the way the decomp numbers them
        k = 0
        pid = {}
        for r in self.regions:
            if r.kind == 'paths':
                for ptr, i, _, _ in r.payload:
                    if ptr:
                        pid[ptr] = i
        nl = np = nt = 0
        used = set()
        for r in self.regions:
            if r.kind == 'path':
                if r.start in pid:
                    r.name = 'path%02d' % pid[r.start]
                    k = 2
                    while r.name in used:        # two arrays can share an id
                        r.name = 'path%02d_%d' % (pid[r.start], k)
                        k += 1
                    used.add(r.name)
                else:
                    r.name = self.n.unreg_paths[np] if np < len(self.n.unreg_paths) else 'unregistered_path%d' % (np + 1)
                    np += 1
            elif r.kind == 'ailist' and r.name is None:
                r.name = self.n.unreg_lists[nl] if nl < len(self.n.unreg_lists) else 'unregistered_func%d' % (nl + 1)
                nl += 1
            elif r.kind == 'rawbytes' and r.name is None:
                r.name = ('zeros_%04x' if not any(d[r.start:r.end]) else 'unknown_%04x') % r.start
        # overlaps are a format misunderstanding; say so loudly
        for a, b in zip(self.regions, self.regions[1:]):
            if b.start < a.end:
                self.warn('regions overlap: %r and %r' % (a, b))

    # -- walkers -------------------------------------------------------
    def prop_len(self, off):
        d = self.d
        typ = d[off + 3]
        cands = self.t.prop_by_type.get(typ)
        if cands:
            return len(cands[0][2])
        if typ in OBJ_LENGTHS:
            return OBJ_LENGTHS[typ]
        return None

    def _walk_props(self, off):
        d = self.d
        while True:
            if off + 4 > len(d):
                raise Fail('props run off the end of the file')
            typ = d[off + 3]
            if typ == OBJTYPE_END:
                return off + 4
            n = self.prop_len(off)
            if n is None:
                # setupGetCmdLength() returns 1 for a type it does not know;
                # do the same so the walk reaches endprops the way the engine does
                self.warn('props: unknown type 0x%02x at +%#x, stepping one word like the engine' % (typ, off))
                n = 1
            off += n * 4

    def _walk_intro(self, off):
        d = self.d
        while True:
            typ = be32(d, off)
            if typ == INTRO_END:
                return off + 4
            cands = self.t.intro_by_type.get(typ)
            if not cands:
                raise Fail('unknown intro op 0x%02x at %#x' % (typ, off))
            off += len(cands[0][2]) * 4

    def cmd_len(self, off):
        d = self.d
        op = (d[off] << 8) | d[off + 1]
        if op == AICMD_PRINT:
            p = off + 2
            while p < len(d) and d[p] != 0:
                p += 1
            return p - off + 1
        if op in self.t.cmdlens:
            return self.t.cmdlens[op]
        return None

    def _walk_list(self, off, limit, strict=False):
        """Return the end of the list starting at off, bounded by limit.

        Ends at the first endlist, unless bytes follow it before the next
        4-byte boundary (then the tail is glued to this list and the walk goes
        on). Whatever follows an aligned end is someone else's - an
        unregistered list, a stray path - and is left for the orphan pass.
        With strict=True an unsizable opcode is a failure, not a raw tail."""
        d = self.d
        p = off
        while p < limit:
            if p + 2 > limit:
                break
            n = self.cmd_len(p)
            if n is None:
                if strict:
                    raise Fail()
                return limit
            op = (d[p] << 8) | d[p + 1]
            p += n
            if op == AICMD_END:
                aligned = (p + 3) & ~3
                if not any(d[p:min(aligned, limit)]):
                    return p
        if strict:
            raise Fail()
        return limit

    def _carve_orphans(self, start, end, keep_zeros=False):
        """Split an unreferenced byte range into the things the decomp would
        write for it: unregistered ailists, stray pad lists, a GE credits
        text table, else raw bytes."""
        d = self.d
        out = []
        p = start
        while p < end:
            if not any(d[p:end]):
                if keep_zeros:
                    out.append(Region(p, end, 'rawbytes', None))
                break
            if p % 4:
                # alignment zeros before the next 4-byte boundary are padding
                aligned = min((p + 3) & ~3, end)
                if not any(d[p:aligned]):
                    p = aligned
                    continue
            if p % 4 == 0:
                # credits text table: words that are offsets to NUL-terminated strings
                tbl = self._text_table(p, end)
                if tbl:
                    out.append(tbl)
                    p = tbl.end
                    continue
                # stray pad list
                q = p
                ok = False
                while q + 4 <= end:
                    v = struct.unpack_from('>i', d, q)[0]
                    q += 4
                    if v == -1:
                        ok = True
                        break
                    if v < 0 or v > 0xffff:
                        break
                if ok:
                    out.append(Region(p, q, 'path', None))
                    p = q
                    continue
            # unregistered ailist
            try:
                e = self._walk_list(p, end, strict=True)
                out.append(Region(p, e, 'ailist', None, None))
                p = (e + 3) & ~3
                continue
            except Fail:
                pass
            # raw to the end of the range (or to the next thing we can parse)
            q = p + 1
            while q < end:
                if q % 4 == 0:
                    try:
                        self._walk_list(q, end, strict=True)
                        break
                    except Fail:
                        pass
                q += 1
            if any(d[p:q]):
                out.append(Region(p, q, 'rawbytes', None))
            p = q
        return out

    def _text_table(self, p, end):
        d = self.d
        ptrs = []
        q = p
        while q + 4 <= end:
            v = be32(d, q)
            if v < 0x20 or v >= len(d) or v % 1 != 0:
                break
            ptrs.append(v)
            q += 4
            if len(ptrs) > 64:
                return None
        if len(ptrs) < 2 or ptrs != sorted(ptrs):
            return None
        strs = []
        for v in ptrs:
            e = d.find(b'\0', v)
            if e < 0 or e == v:
                return None
            sb = d[v:e]
            if any(c < 9 or (13 < c < 32) or c > 126 for c in sb):
                return None
            strs.append(sb.decode('ascii'))
        return Region(p, q, 'texttable', None, (ptrs, strs))

    # -- emission ------------------------------------------------------
    def emit(self):
        out = []
        w = out.append
        w('//')
        w('// %s (disassembled by tools/blahaj)' % self.name)
        w('//')
        w('')
        w('#include "stagesetup.h"')
        w('')
        self._emit_defines(w)
        names = {r.kind: r.name for r in self.regions}
        w('extern s32 intro[];')
        w('extern u32 props[];')
        w('extern struct path paths[];')
        w('extern struct ailist ailists[];')
        w('')
        w('struct stagesetup setup = {')
        for i in range(8):
            h = self.hdr[i]
            kind = {3: 'intro', 4: 'props', 5: 'paths', 6: 'ailists'}.get(i)
            if h and kind and kind in names:
                w('\t%s,' % names[kind])
            elif h:
                w('\t(void *)%#x,' % h)
            else:
                w('\tNULL,')
        w('};')
        w('')
        for r in self.regions:
            if r.kind == 'header':
                continue
            getattr(self, '_emit_' + r.kind)(w, r)
            w('')
        while out and out[-1] == '':
            out.pop()
        return '\n'.join(out) + '\n'

    def _emit_defines(self, w):
        if not self.n.local_defs:
            return
        fam = None
        width = 0
        for f, nm, v in self.n.local_defs:
            if f != fam:
                if fam is not None:
                    w('')
                fam = f
                width = max(len(x[1]) for x in self.n.local_defs if x[0] == f)
            if v < 0:
                vs = str(v)
            elif v >= 0x10000 or f in ('STAGEFLAG_',):
                vs = '0x%08x' % v
            elif v >= 0x100 or f in ('AILIST_', 'PAD_'):
                vs = '0x%04x' % v
            else:
                vs = '0x%02x' % v
            w('#define %-*s %s' % (width, nm, vs))
        w('')

    def _emit_props(self, w, r):
        d = self.d
        w('u32 props[] = {')
        off = r.start
        while off < r.end:
            typ = d[off + 3]
            if typ == OBJTYPE_END:
                w('\tendprops')
                off += 4
                continue
            n = self.prop_len(off) or 1
            words = [be32(d, off + i * 4) for i in range(n)]
            line = self._decode_words(self.t.prop_by_type.get(typ, []), words, 'props')
            if line is None:
                self.raw_props += 1
                why = self.last_mismatch or 'no macro for this type'
                w('\t// raw: OBJTYPE 0x%02x at +%#x: %s' % (typ, off, why))
                for i in range(0, n, 8):
                    w('\t' + ', '.join('0x%08x' % x for x in words[i:i + 8]) + ',')
            else:
                w('\t' + line)
            off += n * 4
        w('};')

    def _emit_intro(self, w, r):
        d = self.d
        w('s32 intro[] = {')
        off = r.start
        while off < r.end:
            typ = be32(d, off)
            if typ == INTRO_END:
                w('\tendintro')
                off += 4
                continue
            cands = self.t.intro_by_type[typ]
            n = len(cands[0][2])
            words = [be32(d, off + i * 4) for i in range(n)]
            line = self._decode_words(cands, words, 'intro')
            if line is None:
                w('\t' + ', '.join('0x%08x' % x for x in words) + ',')
            else:
                w('\t' + line)
            off += n * 4
        w('};')

    def _decode_words(self, cands, words, ctx):
        self.last_mismatch = None
        for name, params, trees in cands:
            if len(trees) != len(words):
                continue
            binds = {}
            lost = []       # (word index, file value, baked expr) accepted under --lossy
            try:
                for i, (tree, wv) in enumerate(zip(trees, words)):
                    try:
                        invert(tree, wv, 32, set(params), binds, self.t.consts)
                    except Fail:
                        self.last_mismatch = '%s word %d is %#010x, macro bakes %s' % (name, i, wv, expr_text(tree))
                        if self.lossy and tree[0] == 'num' and ctx == 'props':
                            lost.append((i, wv, tree[1]))
                            continue
                        raise
            except Fail:
                continue
            if lost:
                self.lossy_words += len(lost)
                note = ' // lossy: ' + ', '.join('word %d was %#010x (macro bakes %#x)' % x for x in lost)
            else:
                note = ''
            args, comments = [], []
            for p in params:
                if p not in binds:
                    args.append('0')
                    continue
                v, bits = binds[p]
                args.append(fmt_arg(self.f, name, p, v, bits, ctx, binds, comments))
            text = '%s(%s)' % (name, ', '.join(args)) if params else name
            if comments:
                text += ' // ' + ', '.join(comments)
            return text + note
        return None

    def _emit_path(self, w, r):
        d = self.d
        w('s32 %s[] = {' % r.name)
        off = r.start
        while off < r.end:
            v = struct.unpack_from('>i', d, off)[0]
            if v < 0:
                w('\t%d,' % v)
            else:
                w('\t%s,' % (self.n.pad(v, 32) or '0x%04x' % v))
            off += 4
        w('};')

    def _emit_paths(self, w, r):
        pathnames = {x.start: x.name for x in self.regions if x.kind == 'path'}
        w('struct path paths[] = {')
        for ptr, pid, pflags, plen in r.payload:
            if ptr == 0:
                w('\t{ NULL, %d, %d },' % (pid, pflags))
            else:
                fl = self.n.flags('PATHFLAG_', pflags, 8) or '0x%02x' % pflags
                w('\t{ %s, %d, %s },' % (pathnames.get(ptr, '(s32 *)%#x' % ptr), pid, fl))
                if plen:
                    self.warn('path %#x has len %d baked in the file' % (ptr, plen))
        w('};')

    def _emit_ailists(self, w, r):
        listnames = {x.start: x.name for x in self.regions if x.kind in ('ailist', 'rawbytes')}
        w('struct ailist ailists[] = {')
        width = max([len(listnames.get(p, '')) for p, _ in r.payload] + [4])
        for ptr, lid in r.payload:
            nm = listnames.get(ptr, '(u8 *)%#x' % ptr)
            idn = self.n.local_name('AILIST_', lid, 32) or '0x%04x' % lid
            w('\t{ %-*s %s },' % (width + 1, nm + ',', idn))
        w('\t{ NULL, 0 },')
        w('};')

    def _emit_texttable(self, w, r):
        ptrs, strs = r.payload
        for i, (ptr, st) in enumerate(zip(ptrs, strs)):
            nm = self.n.textnames[i] if i < len(self.n.textnames) else 'text_%d' % (i + 1)
            w('char *%s = "%s";' % (nm, st.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')))

    def _emit_rawbytes(self, w, r):
        d = self.d
        w('// raw: %#x bytes at +%#x that nothing references and nothing here can read' % (r.end - r.start, r.start))
        w('u8 %s[] = {' % r.name)
        for i in range(r.start, r.end, 16):
            w('\t' + ', '.join('0x%02x' % x for x in d[i:min(i + 16, r.end)]) + ',')
        w('};')

    def _emit_ailist(self, w, r):
        d = self.d
        w('u8 %s[] = {' % r.name)
        p = r.start
        end = self._walk_list(r.start, r.end)
        lines = []     # (indent-delta-before, text, indent-delta-after)
        loops = []     # stack of open loop labels
        cmds = []
        while p < end:
            n = self.cmd_len(p)
            op = (d[p] << 8) | d[p + 1]
            if n is None:
                self.raw_lists += 1
                self.warn('%s: opcode 0x%04x at +%#x (list +%#x) cannot be sized; rest of list is raw' % (r.name, op, p, p - r.start))
                cmds.append(('raw', p, end))
                p = end
                break
            cmds.append(('cmd', p, p + n))
            p += n
        # pass 1: decode to (op, text, label-id)
        decoded = []
        for kind, a, b in cmds:
            if kind == 'raw':
                decoded.append(('raw', a, b, None))
                continue
            op = (d[a] << 8) | d[a + 1]
            text, lab = self._decode_cmd(op, d[a:b])
            fwd = lab if (lab is not None and op not in (AICMD_LABEL, AICMD_GOTO_FIRST)) else None
            decoded.append((op, text, lab, fwd))
        # pass 2: fold label+yield into beginloop, pick endloop/reloop.
        # A loop's body extends past a goto_first(lab) when a command inside
        # the body jumps forward to a label after it (the decomp writes that
        # goto_first as reloop); the first goto_first with nothing pending
        # closes the loop (endloop).
        def next_label(idx, lab):
            for k in range(idx + 1, len(decoded)):
                if decoded[k][0] == AICMD_LABEL and decoded[k][2] == lab:
                    return k
            return None
        # drop a duplicate region walk: same list referenced twice
        i = 0
        indent = 1
        open_loops = []    # [(lab, far)]
        while i < len(decoded):
            item = decoded[i]
            if item[0] == 'raw':
                a, b = item[1], item[2]
                w('\t// raw from list +%#x: opcode 0x%02x%02x has no known length' % (a - r.start, d[a], d[a + 1]))
                for k in range(a, b, 16):
                    w('\t' + ', '.join('0x%02x' % x for x in d[k:min(k + 16, b)]) + ',')
                i += 1
                continue
            op, text, lab, fwd = item[0], item[1], item[2], item[3]
            # forward targets from inside an open loop push its end out
            if fwd is not None and open_loops:
                tgt = next_label(i, fwd)
                if tgt is not None:
                    open_loops[-1][1] = max(open_loops[-1][1], tgt)
            if op == AICMD_LABEL and i + 1 < len(decoded) and decoded[i + 1][0] == AICMD_YIELD \
                    and lab is not None and any(x[0] == AICMD_GOTO_FIRST and x[2] == lab for x in decoded[i + 2:]):
                w('\t' * indent + 'beginloop(%s)' % hexw(lab, 8))
                open_loops.append([lab, i])
                indent += 1
                i += 2
                continue
            if op == AICMD_GOTO_FIRST and open_loops and lab == open_loops[-1][0]:
                # the body continues past this jump only when a forward target
                # lies beyond it AND the code there jumps back to this loop
                # before any other loop opens (the decomp's reloop)
                far = open_loops[-1][1]
                continues = False
                if os.environ.get('BLAHAJ_LOOPRULE') == 'last':
                    continues = any(x[0] == AICMD_GOTO_FIRST and x[2] == lab for x in decoded[i + 1:])
                elif far > i:
                    for k in range(i + 1, len(decoded)):
                        dk = decoded[k]
                        if dk[0] == AICMD_LABEL and k + 1 < len(decoded) and decoded[k + 1][0] == AICMD_YIELD \
                                and any(x[0] == AICMD_GOTO_FIRST and x[2] == dk[2] for x in decoded[k + 2:]):
                            break
                        if dk[0] == AICMD_GOTO_FIRST and dk[2] == lab and k > far:
                            continues = True
                            break
                        if dk[0] == AICMD_END:
                            break
                if not continues:
                    indent -= 1
                    open_loops.pop()
                    w('\t' * indent + 'endloop(%s)' % hexw(lab, 8))
                else:
                    w('\t' * indent + 'reloop(%s)' % hexw(lab, 8))
                w('')
                i += 1
                continue
            if op == AICMD_LABEL and i > 0 and decoded[i - 1][0] not in (AICMD_LABEL,) and w.__self__[-1] != '':
                w('')
            w('\t' * indent + text)
            i += 1
        while open_loops:
            # loop never closed (jumps back from a raw tail, or a dead one): unindent quietly
            open_loops.pop()
            indent -= 1
        # dead tail past the list end, if any
        if end < r.end and any(d[end:r.end]):
            w('\t// bytes after the list end, kept verbatim')
            for k in range(end, r.end, 16):
                w('\t' + ', '.join('0x%02x' % x for x in d[k:min(k + 16, r.end)]) + ',')
        w('};')

    def _decode_cmd(self, op, raw):
        """-> (text, label id or None)"""
        if op == AICMD_PRINT:
            body = raw[2:-1]
            chars = []
            for c in body:
                ch = chr(c)
                if ch == '\n':
                    chars.append("'\\n'")
                elif ch == "'":
                    chars.append("'\\''")
                elif ch == '\\':
                    chars.append("'\\\\'")
                elif 32 <= c < 127:
                    chars.append("'%s'" % ch)
                else:
                    chars.append('0x%02x' % c)
            return 'dprint ' + ','.join(chars + ['0']) + ',', None
        cands = self.t.cmd_by_op.get(op, [])
        for name, params, layout in cands:
            if 2 + sum(b // 8 for _, b in layout) != len(raw):
                continue
            binds = {}
            p = 2
            try:
                for tree, bits in layout:
                    nb = bits // 8
                    v = int.from_bytes(raw[p:p + nb], 'big')
                    invert(tree, v, bits, set(params), binds, self.t.consts)
                    p += nb
            except Fail:
                continue
            lab = None
            args, comments = [], []
            for prm in params:
                if prm not in binds:
                    args.append('0')
                    continue
                v, bits = binds[prm]
                if name in ('label', 'goto_next', 'goto_first'):
                    args.append(hexw(v, bits))
                    lab = v
                else:
                    if prm == 'label':
                        lab = v
                    args.append(fmt_arg(self.f, name, prm, v, bits, 'ai', binds, comments))
            text = '%s(%s)' % (name, ', '.join(args)) if params else name
            if comments:
                text += ' // ' + ', '.join(comments)
            return text, lab
        # known length, no macro: raw bytes for this command only
        return 'mkshort(0x%04x), %s' % (op, ', '.join('0x%02x' % x for x in raw[2:])) + ',', None


