    logging.getLogger().setLevel(logging.ERROR)
elif argparseargs.verbose >= 2:
    logging.getLogger().setLevel(logging.DEBUG)
elif argparseargs.verbose >= 1:
    logging.getLogger().setLevel(logging.INFO)

# Save original cwd before PD chdir (used by commands that take workspace paths)
_original_cwd = os.getcwd()

# Capture our own on-disk location BEFORE any chdir below; used to resolve
# checked-in artifacts like tools/share/pd-<rom-id>/files.json.
