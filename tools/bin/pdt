TOOL_PDTOOLS = TOOL_ROOT / "pdtools"

# Check if --root appears in args (for when user puts it after the command)
if not argparseargs.root and '--root' in argparseargs.args:
    root_idx = argparseargs.args.index('--root')
    if root_idx + 1 < len(argparseargs.args):
        argparseargs.root = argparseargs.args[root_idx + 1]
        # Remove --root and its value from args
        argparseargs.args = argparseargs.args[:root_idx] + argparseargs.args[root_idx+2:]

if argparseargs.properties:
    properties = argparseargs.properties.split(',')
    argparseargs.properties = {prop.split('=')[0]: prop.split('=')[1] for prop in properties}
else: argparseargs.properties = {}

if argparseargs.root:
  # Resolve and normalize the path
  resolved_root = Path(argparseargs.root).expanduser().resolve()
  os.environ['PD'] = str(resolved_root)
  argparseargs.root = str(resolved_root)
  # Change to the project directory
  os.chdir(resolved_root)
elif 'PD' in os.environ:
  argparseargs.root = os.environ['PD']
  # Change to the project directory if PD is set
  os.chdir(Path(os.environ['PD']).expanduser().resolve())
else:
  # Best-effort: try to find a PD project by walking upward. Failure is
  # non-fatal — pure-python commands (build-n64-remote, fdiff, gendat,
  # tex-scan) work fine without a PD root, and container-backed
  # commands will raise a clearer error later via require_container_manager().
  try:
    detected_root = get_pdroot(os.getcwd())
    os.environ['PD'] = str(detected_root)
    argparseargs.root = str(detected_root)
  except Exception:
    logging.info("pdt: not inside a PD project; PD env var left unset.")

if argparseargs.tasklist:
  argparseargs.tasklist = [p for p in argparseargs.tasklist.split(",")]
else: argparseargs.tasklist = []

if argparseargs.jobs == -1:
  argparseargs.jobs = os.cpu_count()


